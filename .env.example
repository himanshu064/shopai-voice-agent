# ShopAI environment variables (spec §20)
# Copy to .env and fill in. NEVER commit .env.

# Database (Neon Postgres)
DATABASE_URL=          # pooled connection (…-pooler.…neon.tech) used at runtime
DIRECT_URL=            # non-pooled connection (same host without -pooler) used by Prisma Migrate          # pooled connection (…-pooler.…neon.tech) used at runtime
DIRECT_URL=            # non-pooled connection (same host without -pooler) used by Prisma Migrate

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID= # public agent id for the browser SDK (from `npm run agent:setup`)
ELEVENLABS_WEBHOOK_SECRET=       # shared secret sent on tool/webhook calls

# App auth & session security
AUTH_SECRET=                    # session/JWT signing
SESSION_TOKEN_SECRET=           # signs the conversation session token passed to ElevenLabs
# When a tool call arrives without a valid session token, fall back to the
# single seeded demo customer so the demo works end-to-end. Set to "false" for a
# production-accurate identity gate (requires reliable session-token delivery).
DEMO_IDENTITY_FALLBACK=true

# Twilio — only needed for the custom register-call bridge.
# With the native integration, Twilio credentials live inside ElevenLabs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App / integrations
APP_URL=http://localhost:3000
EMAIL_PROVIDER_API_KEY=
LLM_API_KEY=                    # only if a custom LLM is later introduced
